{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/rapfi/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{rapfi,logs,tests,tools}/**"
    }
  },
  "regions": [
    "icn1"
  ]
}
